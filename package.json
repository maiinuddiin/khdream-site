{
  "name": "kh-dream-travels-&-tourism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "build:gh-pages": "vite build",
    "deploy": "vite build && gh-pages -d dist --dotfiles",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^5.0.0",
    "arabic-persian-reshaper": "^1.0.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^12.34.3",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.9.8",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.3",
    "postcss": "^8.5.3",
    "qrcode.react": "^4.2.0",
    "quill": "^2.0.3",
    "react": "^19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-to-print": "^3.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.1"
  },
  "overrides": {
    "react-quill": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.23",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "esbuild": "^0.27.5",
    "gh-pages": "^6.3.0"
  }
}
